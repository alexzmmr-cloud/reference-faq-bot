[Unit]
Description=Reference FAQ Telegram Bot
After=network-online.target
Wants=network-online.target
# Если Telegram доступен только через прокси — раскомментируйте обе строки,
# чтобы бот стартовал после прокси-клиента:
# After=network-online.target sing-box.service
# Requires=sing-box.service

[Service]
Type=simple
# Подставьте своего пользователя и путь к проекту
User=faqbot
WorkingDirectory=/opt/faq-bot
ExecStart=/opt/faq-bot/.venv/bin/python /opt/faq-bot/bot.py

# Прокси для доступа к api.telegram.org там, где он заблокирован.
# Оставьте закомментированным, если Telegram доступен напрямую.
# Environment="BOT_PROXY=http://127.0.0.1:2412"

# Перезапуск при любом падении (сетевые обрывы, краш процесса)
Restart=always
RestartSec=10

# Логи идут в journald, читаются через journalctl -u faq-bot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
